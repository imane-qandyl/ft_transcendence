# Frontend Environment Variables

# API Configuration
# Replace 192.168.1.100 with YOUR computer's actual IP address
# Find your IP:
#   Linux: hostname -I | awk '{print $1}'
#   Windows: ipconfig (look for IPv4)
#   Mac: ifconfig | grep "inet "

# For playing on YOUR computer only (localhost)
REACT_APP_API_URL=http://localhost:3000
REACT_APP_WS_URL=http://localhost:3000

# For LAN play (friends connecting from other devices)
# Uncomment and replace with your IP:
# REACT_APP_API_URL=http://192.168.1.100:3000
# REACT_APP_WS_URL=http://192.168.1.100:3000

# Development server port
PORT=3001

# Optional: Enable source maps for debugging
GENERATE_SOURCEMAP=true
